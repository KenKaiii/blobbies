{
  "name": "blobbies",
  "version": "0.8.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build && node scripts/bundle-budget.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "node scripts/tauri-dev.mjs",
    "tauri:build": "tauri build",
    "typecheck": "tsc --build --force",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "sim": "vitest run --config vitest.sim.config.ts sim/agent.sim.ts",
    "sim:caps": "vitest run --config vitest.sim.config.ts sim/capabilities.sim.ts",
    "sim:tools": "vitest run --config vitest.sim.config.ts sim/tools.sim.ts",
    "sim:group": "vitest run --config vitest.sim.config.ts sim/group.sim.ts",
    "sim:recap": "vitest run --config vitest.sim.config.ts sim/recap.sim.ts",
    "sim:routine": "vitest run --config vitest.sim.config.ts sim/routine.sim.ts",
    "sim:stress": "vitest run --config vitest.sim.config.ts sim/stress.sim.ts",
    "sim:fleet": "vitest run --config vitest.sim.config.ts sim/fleet.sim.ts",
    "sim:routing": "vitest run --config vitest.sim.config.ts sim/routing.sim.ts",
    "sim:grounding": "vitest run --config vitest.sim.config.ts sim/grounding.sim.ts",
    "sim:recovery": "vitest run --config vitest.sim.config.ts sim/recovery.sim.ts",
    "rs:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all && cargo fmt --manifest-path src-tauri/acp-relay/Cargo.toml --all",
    "rs:lint": "cargo clippy --manifest-path src-tauri/acp-relay/Cargo.toml --target-dir src-tauri/target --all-targets -- -D warnings && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "rs:test": "cargo test --manifest-path src-tauri/Cargo.toml --all-features",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm rs:lint",
    "prepare": "lefthook install",
    "sim:mcp": "vitest run --config vitest.sim.config.ts sim/mcp.sim.ts",
    "plugins": "node scripts/sync-plugins.mjs",
    "notices": "node scripts/generate-notices.mjs",
    "sim:acp": "vitest run --config vitest.sim.config.ts sim/acp.sim.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@kenkaiiii/gg-agent": "^5.52.0",
    "@kenkaiiii/gg-ai": "^5.52.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-http": "^2.6.0",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "lucide-react": "^1.39.0",
    "openai": "^7.8.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tinfoil": "^1.2.1",
    "zod": "^4.5.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild",
      "lefthook"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
